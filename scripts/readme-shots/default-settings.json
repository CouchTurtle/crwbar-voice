{
  "settings_schema_version": 2,
  "bindings": {
    "transcribe": {
      "id": "transcribe",
      "name": "Transcribe",
      "description": "Converts your speech into text.",
      "default_binding": "option+space",
      "current_binding": "option+space"
    },
    "insert_last_transcript": {
      "id": "insert_last_transcript",
      "name": "Insert Last Transcript",
      "description": "Types the most recent transcription into the focused field, leaving the clipboard untouched.",
      "default_binding": "option+v",
      "current_binding": "option+v"
    },
    "copy_last_transcript": {
      "id": "copy_last_transcript",
      "name": "Copy Last Transcript",
      "description": "Copies the most recent transcription to the clipboard.",
      "default_binding": "option+c",
      "current_binding": "option+c"
    },
    "cancel": {
      "id": "cancel",
      "name": "Cancel",
      "description": "Cancels the current recording.",
      "default_binding": "escape",
      "current_binding": "escape"
    },
    "voice_action": {
      "id": "voice_action",
      "name": "Voice Action",
      "description": "Uses your voice and optional context to generate text with AI.",
      "default_binding": "option+command+space",
      "current_binding": "option+command+space"
    },
    "transcribe_with_post_process": {
      "id": "transcribe_with_post_process",
      "name": "Transcribe with Post-Processing",
      "description": "Converts your speech into text and applies AI post-processing.",
      "default_binding": "option+shift+space",
      "current_binding": "option+shift+space"
    }
  },
  "push_to_talk": true,
  "audio_feedback": false,
  "audio_feedback_volume": 1.0,
  "sound_theme": "marimba",
  "start_hidden": false,
  "autostart_enabled": false,
  "update_checks_enabled": false,
  "show_whats_new_on_update": true,
  "whats_new_last_seen_version": "0.4.0",
  "selected_model": "",
  "onboarding_completed": false,
  "always_on_microphone": false,
  "selected_microphone": null,
  "clamshell_microphone": null,
  "selected_output_device": null,
  "translate_to_english": false,
  "selected_language": "auto",
  "overlay_position": "bottom",
  "debug_mode": false,
  "log_level": "debug",
  "custom_words": [],
  "model_unload_timeout": "min5",
  "word_correction_threshold": 0.18,
  "history_limit": 10,
  "recording_retention_period": "preserve_limit",
  "paste_method": "ctrl_v",
  "clipboard_handling": "dont_modify",
  "auto_submit": false,
  "auto_submit_key": "enter",
